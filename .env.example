# Application Settings
APP_NAME="TaskFlow Orchestrator"
APP_ENV="development"
DEBUG=true
PORT=8000

# Database Configuration (ADR-002: Backend Privileged Connection)
# Production PostgreSQL instance connection URL
DATABASE_URL="postgresql://taskflow_user:supersecretpassword@localhost:5432/taskflow_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true

# JWT Authentication Security
# Generate a cryptographically secure 256-bit secret via: openssl rand -hex 32
JWT_SECRET_KEY="09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# GEMINI_API_KEY: Optional if AI agent features are layered in Phase 3
GEMINI_API_KEY="MY_GEMINI_API_KEY"
